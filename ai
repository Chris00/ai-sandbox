#!/bin/bash
#
# ai — run a shell (or a command) for an AI agent inside a bubblewrap
# sandbox.
#
# Usage: ai [--ssh] [-w|--work DIR] [--] [COMMAND [ARG...]]
#
# The work directory DIR is mounted read-write at /work.  The real
# ".git" directory of every Git repo in it is hidden: the sandbox sees
# a clone kept in $GIT_BACKUP instead, so the AI cannot alter your
# history, config or hooks.  Your real repo is visible read-only under
# /upstream, so "git fetch origin" inside the sandbox picks up your
# latest commits.  To bring the AI's commits back, in your real repo:
#
#     git fetch ai
#     git diff ai/main        # review; empty when the files match
#     git reset ai/main       # move the branch, keep the files
#
# From the host, only ever *fetch from* the copies.  Never push into
# them or run Git commands inside them: their configuration and hooks
# are under the AI's control.

AIHOME="$HOME/AI/home"
GIT_BACKUP="$HOME/AI/work"
AI_SSH_KEY="$HOME/.ssh/id_ed25519_ai"

die() {
    echo "ai: $*" >&2
    exit 1
}

# --- Options ------------------------------------------------------------

ssh=
work_path=
cmd=()

while [[ $# -gt 0 ]]; do
    case $1 in
	--ssh)
	    ssh=1
	    shift
	    ;;
	-w|--work)
	    [ $# -ge 2 ] || die "$1 needs a directory."
	    work_path=$(realpath -e -- "$2" 2>/dev/null) ||
		die "The path \"$2\" does not exist."
	    [ -d "$work_path" ] || die "\"$2\" is not a directory."
	    shift 2
	    ;;
	--)
	    shift
	    cmd=("$@")
	    break
	    ;;
	-*)
	    die "Unknown option $1"
	    ;;
	*)
	    # The command and all its arguments, options included.
	    cmd=("$@")
	    break
	    ;;
    esac
done

# --- Checks -------------------------------------------------------------

[ -d "$AIHOME" ] ||
    die "Create the directory '$AIHOME' with minimal configuration files."
[ -x /usr/bin/bwrap ] ||
    die "bubblewrap is not installed (e.g. 'apt install bubblewrap')."
command -v slirp4netns >/dev/null ||
    die "slirp4netns is not installed (e.g. 'apt install slirp4netns')."
command -v nsenter >/dev/null ||
    die "nsenter is not installed (e.g. 'apt install util-linux')."
nsenter --help | grep -q -- --user-parent ||
    die "nsenter is too old, it does not support '--user-parent'."
command -v gawk >/dev/null ||
    die "gawk is not installed."

if [ -n "$ssh" ] && [ ! -r "$AI_SSH_KEY" ]; then
    die "--ssh: create the agent's key first: ssh-keygen -t ed25519 -f '$AI_SSH_KEY' -C ai-agent"
fi

if [ -n "$work_path" ]; then
    if [ "$work_path" = / ]; then
	die "Refusing to expose the whole file system."
    fi
    case $HOME/ in
	"$work_path"/*)
	    die "Refusing to expose your whole home directory ($work_path)." ;;
    esac
    case $work_path/ in
	"$HOME"/.*)
	    die "Refusing to expose configuration files ($work_path)." ;;
	"$HOME/AI"/*)
	    die "Refusing to expose the sandbox's own files ($work_path)." ;;
	"$HOME/Personal"/*)
	    die "Refusing to expose your personal files ($work_path)." ;;
    esac
fi

# --- Helpers ------------------------------------------------------------

# Host-side Git: never run hooks or the fsmonitor.
git() {
    /usr/bin/git -c core.hooksPath=/dev/null -c core.fsmonitor=false "$@"
}

rel_to_pwd() {
    case $1 in
	"$PWD")   echo . ;;
	"$PWD"/*) echo "./${1#"$PWD"/}" ;;
	*)        echo "$1" ;;  # not under the current directory
    esac
}

confirm() {    # confirm QUESTION: true if the user answers yes
    local answer
    read -r -p "$1 [y/N] " answer </dev/tty || return 1
    [[ $answer == [yY]* ]]
}

# Files in $1 with a hard link outside it.  The .git directories are
# skipped: protect_repos hides them from the sandbox.
outside_hardlinks() {
    find "$1" -name .git -prune -o -type f -links +1 -printf '%D:%i %n %p\0' |
	gawk 'BEGIN { RS = "\0" }
	      { k = $1; n[k] = $2; c[k]++
		if (!(k in p)) p[k] = substr($0, length($1) + length($2) + 3) }
	      END { for (k in c) if (c[k] < n[k]) print p[k] }'
}

# File systems mounted inside $1 (bwrap binds recursively).
inner_mounts() {
    local m
    findmnt -rn -o TARGET | while IFS= read -r m; do
	case $m in "$1"/*) echo "$m" ;; esac
    done
}

# Symlinks in $1 resolving outside it, as NUL-separated "link → target".
outside_symlinks() {
    local f
    while IFS= read -r -d '' f; do
	case $(realpath -m -- "$f") in
	    "$1"|"$1"/*) ;;
	    *) printf '%s → %s\0' "$(rel_to_pwd "$f")" "$(readlink -- "$f")" ;;
	esac
    done < <(find "$1" -name .git -prune -o -type l -print0)
}

if [ -t 1 ]; then
    red=$'\e[31m' normal=$'\e[0m'
else
    red= normal=
fi

# Hide the real .git of each repo under $work_path behind a clone in
# $GIT_BACKUP, and show the real one read-only under /upstream.
protect_repos() {
    local f g repo rel_home copy upstream answer
    local -a links repos

    # Submodules and worktrees have a ".git" *file*: their Git data is
    # elsewhere and not mounted, so Git will not work on them inside.
    mapfile -d '' -t links < <(
	find "$work_path" -name .git \( -type d -prune -o -type f -print0 \)
    )
    for f in "${links[@]}"; do
	echo "Not handled (submodule or worktree): $(rel_to_pwd "${f%/.git}")" >&2
    done

    # Shallowest first, so that an enclosing repo is cloned before the
    # repos nested in it (Git refuses to clone into a non-empty dir).
    mapfile -d '' -t repos < <(
	find "$work_path" -name .git -type d -prune -printf '%d\t%p\0' |
	    LC_ALL=C sort -z -n -s -k1,1 |
	    cut -z -f2-
    )

    for g in "${repos[@]}"; do
	repo=${g%/.git}
	rel_home=${repo#"$HOME"/}
	copy="$GIT_BACKUP/$rel_home"
	# The ".git" suffix keeps nested repos on separate mount points.
	upstream="/upstream/$rel_home.git"

	printf 'Git %s%s%s → %s\n' "$red" "$(rel_to_pwd "$repo")" "$normal" "$copy"

	if [ ! -d "$copy/.git" ]; then
	    # No copy yet: either a repo of yours seen for the first time,
	    # or one the AI created in the shared tree in an earlier
	    # session, whose configuration would be untrusted.
	    confirm "  New repo: did you create it yourself?" ||
		die "Not trusting $repo."

	    mkdir -p -- "$(dirname -- "$copy")" || exit 1
	    # Cloning reads the source through upload-pack, which is
	    # safe even in an untrusted repo.
	    git clone --no-local --no-checkout --quiet -- "$repo" "$copy" ||
		exit 1
	    # Safe: the copy was just created.  Fill its index from HEAD
	    # (fails harmlessly on a repo without commits) and point its
	    # origin at the read-only view of your repo in the sandbox.
	    git -C "$copy" reset --quiet 2>/dev/null
	    git -C "$copy" remote set-url origin "$upstream"
	    # Writing the config file directly runs nothing.
	    /usr/bin/git config --file "$g/config" --remove-section remote.ai \
			 2>/dev/null
	    /usr/bin/git config --file "$g/config" remote.ai.url "$copy"
	    /usr/bin/git config --file "$g/config" remote.ai.fetch \
			 '+refs/heads/*:refs/remotes/ai/*'
	    /usr/bin/git config --file "$g/config" remote.ai.tagOpt --no-tags
	    /usr/bin/git config --file "$g/config" fetch.fsckObjects true
	fi

	args+=(
	    --bind "$copy/.git" "/work/${g#"$work_path"/}"
	    --ro-bind "$g" "$upstream"
	)
    done
}

# --- Temporary files (removed on exit) ----------------------------------

tmp=$(mktemp -d -t ai.XXXXXXXX) || exit 1
# `slirp` will hold (see below) the process ID of the background job
# that runs slirp4netns, so the EXIT trap knows what to kill.
slirp=
agent_pid=

cleanup() {
    local new
    [ -n "$slirp" ] && kill "$slirp" 2>/dev/null
    [ -n "$agent_pid" ] && kill "$agent_pid" 2>/dev/null
    if [ -f "$tmp/symlinks.before" ]; then
	new=$(LC_ALL=C comm -z -13 "$tmp/symlinks.before" \
		     <(outside_symlinks "$work_path" | LC_ALL=C sort -z) |
		  tr '\0' '\n')
	if [ -n "$new" ]; then
	    {
		echo "$(date '+%F %T') New symlinks out of $work_path (don't follow them blindly):"
		sed 's/^/  /' <<<"$new"
	    } | tee -a "$HOME/AI/warnings.log" >&2
	fi
    fi
    rm -rf -- "$tmp"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

mkfifo "$tmp/info" "$tmp/block" || exit 1
# slirp4netns provides a DNS forwarder at 10.0.2.3.
printf 'nameserver 10.0.2.3\n' >"$tmp/resolv.conf"

getent passwd "$(id -u)" >"$tmp/passwd"
getent group "$(id -g)" >"$tmp/group"
printf 'passwd: files\ngroup: files\nhosts: files dns\n' >"$tmp/nsswitch.conf"

if [ -n "$ssh" ]; then
    # A private agent holding only the AI's key; it dies with the script.
    agent_sock="$tmp/agent.sock"
    agent_pid=$(ssh-agent -s -a "$agent_sock" |
		    sed -n 's/^SSH_AGENT_PID=\([0-9]*\);.*/\1/p')
    [ -n "$agent_pid" ] || die "--ssh: could not start ssh-agent."
    SSH_AUTH_SOCK=$agent_sock ssh-add -q "$AI_SSH_KEY" </dev/tty ||
	die "--ssh: could not load $AI_SSH_KEY."
fi

# --- Sandbox ------------------------------------------------------------

args=(
    --die-with-parent
    --new-session
    --unshare-all

    --clearenv
    --setenv PATH /usr/bin:/bin
    --setenv TERM "$TERM"
    --setenv LANG "${LANG:-C.UTF-8}"

    --dev /dev
    --proc /proc
    --tmpfs /tmp

    --ro-bind /usr /usr
    --ro-bind /lib /lib
    --ro-bind-try /lib64 /lib64
    --ro-bind /bin /bin
    --ro-bind-try /etc/alternatives /etc/alternatives
    --ro-bind "$tmp/resolv.conf" /etc/resolv.conf
    --ro-bind /etc/hosts /etc/hosts
    --ro-bind /etc/ssl /etc/ssl
    --ro-bind "$tmp/passwd" /etc/passwd
    --ro-bind "$tmp/group" /etc/group
    --ro-bind-try /etc/localtime /etc/localtime
    --ro-bind-try /etc/ld.so.cache /etc/ld.so.cache
    --ro-bind "$tmp/nsswitch.conf" /etc/nsswitch.conf
    --unshare-user
    --bind "$AIHOME/" "$HOME/"
    --setenv HOME "$HOME"
    --setenv USER "$USER"
)

if [ -n "$ssh" ]; then
    args+=(
	--ro-bind-try "$HOME/.ssh/known_hosts" "$HOME/.ssh/known_hosts"
	--bind "$agent_sock" /run/ssh-agent.sock
	--setenv SSH_AUTH_SOCK /run/ssh-agent.sock
    )
fi

if [ -n "$work_path" ]; then
    links=$(outside_hardlinks "$work_path")
    if [ -n "$links" ]; then
	echo "Hard-linked outside the work dir (the sandbox could modify these files):" >&2
	sed 's/^/  /' <<<"$links" >&2
	confirm "Continue anyway?" || exit 1
    fi
    mounts=$(inner_mounts "$work_path")
    if [ -n "$mounts" ]; then
	echo "File systems mounted inside the work dir (exposed too):" >&2
	sed 's/^/  /' <<<"$mounts" >&2
	confirm "Continue anyway?" || exit 1
    fi
    outside_symlinks "$work_path" | LC_ALL=C sort -z >"$tmp/symlinks.before"

    # Mount outside $HOME: / is a tmpfs, so no mount point is left
    # behind in $AIHOME.
    args+=(
	--bind "$work_path" /work
	--chdir /work
    )
    if [ "${work_path#"$HOME"/}" = "$work_path" ]; then
	# E.g. to experiment in a /tmp directory.
	echo "$work_path is not under \$HOME: its Git repos are NOT protected." >&2
    else
	protect_repos
    fi
else
    # No work directory, e.g. to install packages or AI tools in $HOME.
    args+=(--chdir "$HOME")
fi

if [ ${#cmd[@]} -eq 0 ]; then
    # Allocate a pseudo-terminal for bash (so one has job control with
    # Ctrl-Z, fg, bg):
    cmd=(script -qc 'bash -i' /dev/null)
fi

# --- Network ------------------------------------------------------------

# slirp4netns rather than --share-net: sharing the host's network
# namespace would let the sandbox reach services listening on the
# host's localhost (databases, dev servers, CUPS...).
#
# Wait for bwrap to report the sandbox PID, then attach the network to
# it.  slirp4netns writes to the block pipe when ready, which releases
# bwrap.
(
    while IFS= read -r line; do
	if [[ $line =~ \"child-pid\":\ *([0-9]+) ]]; then
	    pid=${BASH_REMATCH[1]}
	    break
	fi
    done <"$tmp/info"
    [ -n "$pid" ] || exit 1
    # The user namespace owning the sandbox's network namespace.  bwrap
    # later moves the sandbox into a namespace nested in it.
    owner=$(lsns -t net -p "$pid" -n -o ONS) || exit 1
    owner="user:[${owner//[[:space:]]/}]"
    for _ in {1..200}; do
	[ "$(readlink "/proc/$pid/ns/user")" != "$owner" ] && break
	sleep 0.01
    done
    if [ "$(readlink "/proc/$pid/ns/user")" != "$owner" ]; then
	userns=(--user --user-parent)    # nested: join its parent
    else
	userns=(--user)                  # not nested (yet)
    fi
    exec nsenter --target "$pid" "${userns[@]}" --preserve-credentials \
	 slirp4netns --configure --mtu=65520 --disable-host-loopback \
	 --enable-sandbox --enable-seccomp \
	 --ready-fd=3 --netns-type=path "/proc/$pid/ns/net" tap0 \
	 3>"$tmp/block" >/dev/null \
	 2> >(grep --line-buffered -v -E '^(sent tapfd=[0-9]+ for tap0|received tapfd=[0-9]+)$' >&2)
) &
slirp=$!

# --- Run ----------------------------------------------------------------

# The block pipe is opened read-write: read-only would wait for a
# writer, and slirp4netns only opens it once bwrap has started.
/usr/bin/bwrap --info-fd 3 --block-fd 4 "${args[@]}" "${cmd[@]}" \
	       3>"$tmp/info" 4<>"$tmp/block"
exit $?
