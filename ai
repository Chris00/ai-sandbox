@dataclasses.dataclass
class Config:
    AIHOME: str
    PROJECTS: str
    AI_SSH_KEY: str
    BWRAP: str
    PYTHON: str
    NFT_RULES: str
    LOCKDIR: str
    AI_LOG: str
    FORBID_WORK: list
    PRIVATE: list
    READONLY: list
    PRIVATE_IF: dict
    HOME_TRIGGERS: list
    HOME_IGNORE: list
    HOME_GROUPS: list
    AI_SSH_HOSTS: list
    AI_ENV: list
    AI_PROJECT_ENV: list
    AGENT_EVENTS: dict
    AI_MEMORY: object
    AI_SWAP: object
    AI_CPUS: object
    AI_TASKS: object
    # Where it was read from.
    files: tuple

    def __post_init__(self):
        # Entries the agent creates during the session can't be protected:
        # the check at exit reports new and changed ones (and new repos).
        self.TRIGGERS = [".git", *self.PRIVATE, *self.READONLY]
        self.trigger_expr = name_tests(self.TRIGGERS)
        self.home_triggers = home_patterns(self.HOME_TRIGGERS)
        self.home_ignore = home_patterns(self.HOME_IGNORE)
        self.home_groups = [re.compile(fnmatch.translate(p)) for p in self.HOME_GROUPS]


def home_patterns(patterns):
    """A regex for the paths that match one of `patterns` or are in one:
    "*" also matches "/"."""
    tests = [fnmatch.translate(t) for p in patterns for t in (p, f"{p}/*")]
    return re.compile("|".join(tests) or "(?!)")


def check_settings(settings):
    """Refuse settings of the wrong type: they would be taken for others,
    a string for a list of letters, say."""
    for field in dataclasses.fields(Config):
        if field.name not in settings:
            continue
        value = settings[field.name]
        if field.type is str or field.type == "str":
            if isinstance(value, os.PathLike):
                value = settings[field.name] = os.fspath(value)
            good = isinstance(value, str)
        elif field.type is list:
            if isinstance(value, tuple):
                value = settings[field.name] = list(value)
            if isinstance(value, list):
                value = settings[field.name] = [
                    os.fspath(v) if isinstance(v, os.PathLike) else v for v in value]
            good = isinstance(value, list) and all(isinstance(v, str) for v in value)
        elif field.type is dict:
            good = isinstance(value, dict) and all(
                isinstance(k, str) and isinstance(v, str) for k, v in value.items())
        else:
            good = value is None or isinstance(value, (str, int))
        if not good:
            kind = getattr(field.type, "__name__", str(field.type))
            if kind == "object":
                kind = "str or int"
            die(f"{field.name} in your configuration must be a {kind}, "
                f"not {type(value).__name__}.")


def load_config(home):
    """The settings, changed by your configuration: Python code, run
    after the defaults are set, which it can change (with "+=" to add to
    a list).  It also has HOME."""
    path, old = f"{home}/AI/config.py", f"{home}/AI/config"
    settings = default_settings(home)
    if os.path.lexists(path):
        # It runs with your rights: refuse it if someone else could have
        # changed it.
        try:
            st = os.stat(path)
        except OSError as e:
            die(f"{path}: {e.strerror}.")
        if st.st_uid != os.geteuid() or st.st_mode & 0o022:
            die(f"{path} must be yours, and writable by you only (chmod 600).")
        namespace = dict(settings, HOME=home, __file__=path, __name__="ai_config")
        try:
            with open(path, "rb") as f:
                source = f.read()
            exec(compile(source, path, "exec"), namespace)
        except SystemExit:
            raise
        except BaseException as e:
            if isinstance(e, SyntaxError):
                lines = [e.lineno]
            else:
                lines = [f.lineno for f in traceback.extract_tb(e.__traceback__)
                         if f.filename == path]
            # None when compiling it fails otherwise: too complex, say.
            where = f"{path}, line {lines[-1]}" if lines and lines[-1] else path
            die(f"{where}: {type(e).__name__}: {e}")
        # A misspelt setting would otherwise do nothing: FORBID_WORKS, say.
        unknown = sorted(name for name in namespace if re.fullmatch("[A-Z][A-Z0-9_]*", name)
                         and name not in settings and name != "HOME")
        if unknown:
            die(f"{path}: no such setting: {', '.join(unknown)} (name your own "
                "variables in lowercase).")
        settings = {name: namespace.get(name, value) for name, value in settings.items()}
    elif os.path.lexists(old):
        # Going on without it would drop what it asks: FORBID_WORK, for one.
        die(f"{old} is in bash, which ai no longer reads: write it in Python, "
            f"as {path} (see the README).")
    check_settings(settings)
    for e in settings["AI_ENV"] + settings["AI_PROJECT_ENV"]:
        # Only the name: the value may be a secret.
        if not re.match(r"[A-Za-z_][A-Za-z0-9_]*=", e) or "\0" in e:
            die('AI_ENV and AI_PROJECT_ENV take NAME=value entries, not '
                f'"{e.partition("=")[0]}...".')
    return Config(**settings, files=(path, old))


def resource_limits(cfg):
    """The limits of the scope, with their defaults, as strings."""
    memory = str(cfg.AI_MEMORY or "50%")        # of the RAM
    swap = cfg.AI_SWAP
    if not swap:
        swap = ""
        with open("/proc/meminfo") as f:
            for line in f:
                if line.startswith("SwapTotal:"):
                    swap = f"{int(line.split()[1]) // 2}K"
    cpus = str(cfg.AI_CPUS or (len(os.sched_getaffinity(0)) + 1) // 2)
    tasks = str(cfg.AI_TASKS or 1024)           # processes and threads
    if not (re.fullmatch("[1-9][0-9]*", cpus) and re.fullmatch("[1-9][0-9]*", tasks)):
        die("AI_CPUS and AI_TASKS must be positive integers.")
    return memory, str(swap), cpus, tasks


def enter_scope(limits, argv):
    """Run ai again in a systemd scope with the resource limits, if there
    is a systemd user session."""
    memory, swap, cpus, tasks = limits
    try:
        systemd = subprocess.run(["systemctl", "--user", "show-environment"],
                                 stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL).returncode == 0
    except OSError:
        systemd = False
    if systemd:
        os.environ["AI_IN_SCOPE"] = "1"
        os.execvp("systemd-run", [
            "systemd-run", "--user", "--scope", "--quiet",
            "--description=AI sandbox",
            "-p", f"MemoryMax={memory}",
            "-p", f"MemorySwapMax={swap}",
            "-p", f"CPUQuota={int(cpus) * 100}%",
            "-p", "CPUWeight=50",
            "-p", "IOWeight=50",
            "-p", f"TasksMax={tasks}",
            "-p", "OOMPolicy=continue",
            # The same Python, with the flags of the first line.
            "--", sys.executable, "-I", "-X", "utf8", os.path.realpath(__file__), *argv])
    print("ai: no systemd user session: running WITHOUT resource limits.", file=sys.stderr)


# --- Helpers ------------------------------------------------------------

CONTROLS = re.compile("[\x00-\x1f\x7f-\x9f]")
CONTROLS_IN_TEXT = re.compile("[\x01-\x08\x0b-\x1f\x7f-\x9f]")


def safe(name):
    """`name` with the control characters, which could drive your
    terminal, replaced by "?".  For what may come from the agent: the
    names of files in the work dir, for one, so for every path shown.
    The C1 controls are replaced too: U+009B, for one, is CSI, like ESC [."""
    return CONTROLS.sub("?", name)


def safe_text(text):
    """Like safe, but keep tabs and newlines."""
    return CONTROLS_IN_TEXT.sub("?", text)


def indent(lines):
    """Show the lines, made safe, indented."""
    return "".join(f"  {line}\n" for line in safe_text(lines).split("\n"))


def warn(message):
    print(message, file=sys.stderr)


def die(message):
    warn(f"ai: {safe(message)}")
    raise Exit(1)


def rel_to_pwd(path):
    """`path` to show, relative to the current directory if under it."""
    if path == PWD:
        return "."
    if path.startswith(f"{PWD}/"):
        return safe(f"./{path[len(PWD) + 1:]}")
    return safe(path)


def rel_to_home(path):
    """`path` to show, relative to your home if under it."""
    home = os.environ["HOME"]
    if path == home:
        return "~"
    if path.startswith(f"{home}/"):
        return safe(f"~/{path[len(home) + 1:]}")
    return safe(path)


def glob_escape(path):
    """`path` as a pattern matching itself only (for find's -path...)."""
    return re.sub(r"([\\*?\[\]])", r"\\\1", path)


def inside(a, b):
    """True if `a`, a realpath, is `b` or in it.  `b` may not exist; its
    symlinks are resolved."""
    b = os.path.realpath(b)
    return a == b or a.startswith(f"{b}/")


def overlaps(a, b):
    """True if `a`, a realpath, is `b` or in it or contains `b`.  `b` may
    not exist; its symlinks are resolved."""
    b = os.path.realpath(b)
    return a == b or a.startswith(f"{b}/") or b.startswith(f"{a}/")


def read_path_file(path):
    """The path recorded in the file `path`, ending with a newline."""
    with open(path, "rb") as f:
        return os.fsdecode(f.read()).removesuffix("\n")


def git_link_target(f):
    """Where a .git symlink or gitfile ("gitdir: PATH") points to."""
    if os.path.islink(f):
        return os.path.realpath(f)
    with open(f, "rb") as file:
        first = os.fsdecode(file.readline()).removesuffix("\n")
    target = first.removeprefix("gitdir: ") if first.startswith("gitdir: ") else ""
    return os.path.realpath(os.path.join(os.path.dirname(f), target))


def confirm(question):
    """True if the user answers yes, on the terminal."""
    try:
        # Unbuffered: what is typed next is for the next question.
        with open("/dev/tty", "r+b", buffering=0) as tty:
            print(f"{question} [y/N] ", end="", file=sys.stderr, flush=True)
            answer = tty.readline()
    except OSError:
        return False
    return answer.endswith(b"\n") and answer[:1] in (b"y", b"Y")


def capture(argv, **kwargs):
    """The text printed by the command `argv`, without the final newline
    (one only: it may be a name's), or None if it fails."""
    p = subprocess.run(argv, stdout=subprocess.PIPE, **ENCODING, **kwargs)
    return p.stdout.removesuffix("\n") if p.returncode == 0 else None


def git(*args):
    """Host-side Git: never run hooks or the fsmonitor."""
    return ["/usr/bin/git", "-c", "core.hooksPath=/dev/null", "-c", "core.fsmonitor=false", *args]


def git_config(*args):
    """Writing the config file directly runs nothing, follows no include."""
    return ["/usr/bin/git", "config", "--file", *args]


def find(*args, quiet=False, cwd=None):
    """What `find ARGS -print0` or `-printf '...\\0'` prints, as a list.
    The real find, for what a tree from the agent can be: deeper than a
    path can be long, say.  quiet: without its errors, on a tree that may
    hold unreadable directories; otherwise, they are shown made safe."""
    p = subprocess.run(["find", *args], cwd=cwd, stdout=subprocess.PIPE,
                       stderr=subprocess.DEVNULL if quiet else subprocess.PIPE)
    if p.stderr:
        sys.stderr.write(safe_text(os.fsdecode(p.stderr)))
    return [os.fsdecode(entry) for entry in p.stdout.split(b"\0")[:-1]]


def name_tests(names, flag="-name"):
    """The test for find that `names` are, one being enough."""
    tests = []
    for name in names:
        tests += ["-o", flag, name]
    return tests[1:]


def du(path):
    """The size of `path`, for humans, even if it can't read all of it:
    overlayfs leaves its work directory unreadable."""
    p = subprocess.run(["du", "-sh", "--", path], stdout=subprocess.PIPE,
                       stderr=subprocess.DEVNULL, **ENCODING)
    return p.stdout.split("\t", 1)[0]


def timestamp(when=None, fmt="%F %T"):
    return time.strftime(fmt, time.localtime(when))


def markup(text):
    """`text` for the body of a notification, which some notification
    servers read as markup (<b>, <a href>...)."""
    return text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def valid_utf8(text):
    """`text` without the bytes that aren't UTF-8: notify-send refuses it
    otherwise, and the notification would be lost."""
    return text.encode(**ENCODING).decode("utf-8", "ignore")


def find_icon(name, fallback):
    """The icon `name` of the notifications, in the repo next to the
    script or installed in your icon theme; otherwise the theme's icon
    `fallback`."""
    data = os.environ.get("XDG_DATA_HOME") or f"{os.environ['HOME']}/.local/share"
    for icon in (f"{os.path.dirname(os.path.realpath(__file__))}/icons/{name}.svg",
                 f"{data}/icons/hicolor/scalable/apps/{name}.svg"):
        if os.access(icon, os.R_OK):
            return icon
    return fallback


def notify(*args):
    """Show a desktop notification, if possible: the reports don't need it."""
    try:
        subprocess.run(["notify-send", *args], stderr=subprocess.DEVNULL)
    except OSError:
        pass


def project_dir(cfg, path):
    """The directory of PROJECTS for the project `path` (a realpath): its
    path escaped by systemd-escape, so that projects never nest, and
    readable ("home-you-software-proj").  A long path, all the more a
    non-ASCII one (each byte gives 4 characters), would exceed the 255
    bytes of a file name: its name then keeps only the beginning, followed
    by a hash of the whole path."""
    name = capture(["systemd-escape", "--path", "--", path])
    if name is None:
        raise Exit(1)
    if len(name) > 200:                 # ASCII: characters are bytes
        name = f"{name[:183]}-{hash_path(path)}"
    return f"{cfg.PROJECTS}/{name}"


def hash_path(path):
    return hashlib.sha256(os.fsencode(path)).hexdigest()[:16]


def check_plain_config(g):
    """Refuse to go on unless the config of the .git directory `g` is a
    regular file with no other name: git config writes through symlinks
    and hard links."""
    config = f"{g}/config"
    try:
        st = os.lstat(config)
    except FileNotFoundError:
        return
    if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
        die(f"{config} is not a plain file: not touching {g.removesuffix('/.git')}.")


def git_repos(path, quiet=False):
    """The .git directories under `path`, shallowest first, so that an
    enclosing repo comes before the repos nested in it."""
    found = find(path, "-name", ".git", "-type", "d", "-prune", "-printf", "%d\t%p\\0", quiet=quiet)
    entries = [entry.split("\t", 1) for entry in found]
    return [p for _, p in sorted(entries, key=lambda e: int(e[0]))]


# --- Locks --------------------------------------------------------------
#
# The kernel releases a lock with its file descriptor, whatever the
# reason the program ends, and no child inherits it: descriptors aren't
# inherited, unless asked.


def session_lock(cfg, path):
    """The lock file of the session working in `path`."""
    return f"{cfg.LOCKDIR}/{hash_path(path)}.session"


def is_locked(path):
    """True if someone holds the lock file `path`."""
    try:
        fd = os.open(path, os.O_RDONLY)
    except OSError:
        return False
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return False
    except OSError:
        return True
    finally:
        os.close(fd)


def open_lock(path):
    return os.open(path, os.O_WRONLY | os.O_CREAT, 0o666)


def lock_work_path(cfg, path):
    """Refuse to start when another session's work dir is `path`, contains
    it or is inside it; otherwise register it.  The lock stays held until
    the program exits.  Each session holds a lock on a file in LOCKDIR
    containing its work dir, so an entry is active exactly as long as its
    session runs; the global lock makes checking and registering atomic.

    `path` must be the realpath."""
    os.makedirs(cfg.LOCKDIR, exist_ok=True)
    global_lock = open_lock(f"{cfg.LOCKDIR}/global.lock")
    try:
        fcntl.flock(global_lock, fcntl.LOCK_EX)
    except OSError:
        die(f"Cannot lock {cfg.LOCKDIR}.")
    for name in sorted(os.listdir(cfg.LOCKDIR)):
        if not name.endswith(".session"):
            continue
        f = f"{cfg.LOCKDIR}/{name}"
        if not is_locked(f):
            os.unlink(f)                # nobody holds it: a finished session
            continue
        other = read_path_file(f)
        if other == path:
            die(f"A session is running in {path}.")
        if f"{path}/".startswith(f"{other}/"):
            die(f"Another session works in {other}, which contains {path}.")
        if f"{other}/".startswith(f"{path}/"):
            die(f"Another session works in {other}, inside {path}.")
    fd = open_lock(session_lock(cfg, path))
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        die(f"Another session is using {path}.")
    os.ftruncate(fd, 0)
    os.write(fd, os.fsencode(f"{path}\n"))
    HELD_LOCKS.append(fd)
    os.close(global_lock)


def lock_home(cfg, mode):
    """Take the lock of the agent's base home, AIHOME, in `mode` "shared"
    for a project session, which sees it as the lower layer of its
    overlay, or "exclusive" for a session in it (without -w): a lower
    layer must not change while it is mounted.  Held until the program
    exits."""
    os.makedirs(cfg.LOCKDIR, exist_ok=True)
    fd = open_lock(f"{cfg.LOCKDIR}/home.lock")
    try:
        if mode == "shared":
            fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
        else:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        if mode == "shared":
            die("A session in the agent's home (ai without -w) is running: end it first.")
        die("Project sessions are running, and the agent's home must not change "
            "under them: end them first.")
    HELD_LOCKS.append(fd)


HELD_LOCKS = []                         # so that they aren't collected


def register_project(cfg, path):
    """Refuse `path` as a project if a recorded project contains it or is
    inside it (a repo in both would get two clones); otherwise create the
    project's directory and return it.  You must call it with the
    session's lock held (see lock_work_path), so that no overlapping
    session starts meanwhile.

    `path` must be the realpath."""
    for f in project_path_files(cfg):
        other = read_path_file(f)
        if other == path:
            continue
        if f"{path}/".startswith(f"{other}/"):
            die(f"{path} is inside the project {other}: work there, or delete "
                f"{os.path.dirname(f)}.")
        if f"{other}/".startswith(f"{path}/"):
            die(f"{path} contains the project {other}: work there, or delete "
                f"{os.path.dirname(f)}.")
    project = project_dir(cfg, path)
    os.makedirs(project, exist_ok=True)
    # Rewritten at each session: its time is the project's latest use.
    with open(f"{project}/path", "wb") as f:
        f.write(os.fsencode(f"{path}\n"))
    return project


def project_path_files(cfg):
    """The file of each project recording its path."""
    try:
        names = sorted(os.listdir(cfg.PROJECTS), key=os.fsencode)
    except OSError:
        return []
    files = (f"{cfg.PROJECTS}/{name}/path" for name in names if not name.startswith("."))
    return [f for f in files if os.path.isfile(f)]



# --- The agent's home: what changed -------------------------------------


def home_snapshot(path, patterns=None):
    """The files in `path`, the agent's home or a layer of it (only those
    matching the glob `patterns`, if given), as a set of (TYPE, CTIME, PATH),
    PATH being relative to `path`, and TYPE "d" for a whiteout, which records
    a deletion in a layer, "f" otherwise.  CTIME is the time of the latest
    change: the sandbox can't set it back.  It is 0 for whiteouts: overlayfs
    makes them hard links to one file, whose ctime changes at each mount."""
    if patterns is None:
        starts = ["."]
    else:
        # "./": no name is taken for an option.
        starts = [f"./{m}" for p in patterns for m in glob.glob(p, root_dir=path)]
        if not starts:
            return set()
    try:
        found = find(*starts, "-mindepth", "0",
                     "(", "-type", "c", "-printf", "d\t0\t%p\\0",
                     "-o", "!", "-type", "d", "-printf", "f\t%C@\t%p\\0", ")",
                     quiet=True, cwd=path)
    except OSError:
        return set()
    return {(kind, ctime, name.removeprefix("./"))
            for kind, ctime, name in (entry.split("\t", 2) for entry in found)}


def home_group(cfg, path):
    """The rank and the key of `path`, relative to the agent's home, from
    the first pattern of HOME_GROUPS (its index is the rank) that matches
    it or one of its directories, the shortest: the key is that directory
    followed by "/", or `path` itself.  None if none matches."""
    parts = path.split("/")
    prefixes = ["/".join(parts[:i + 1]) for i in range(len(parts))]
    for rank, pattern in enumerate(cfg.home_groups):
        for prefix in prefixes:
            if pattern.match(prefix):
                return rank, path if prefix == path else f"{prefix}/"
    return None


def summarize_home(cfg, changes, only_triggers=False):
    """Sum up `changes`, files of the agent's home as pairs (TYPE, PATH),
    TYPE "d" for a deletion, "f" otherwise, PATH relative to the home: one
    line per entry, those of HOME_GROUPS first, then the others two levels
    down (.claude/plugins/), a directory with a single file shown as that
    file.  "!" marks the entries with HOME_TRIGGERS; with `only_triggers`,
    only those are shown.  Of the files of HOME_IGNORE that aren't
    triggers, only the number is given.  Empty if there is nothing to show."""
    ignored = 0
    entries = {}                        # key -> [rank, first, count, marked]
    for kind, path in changes:
        path = safe(path)               # from the agent
        trigger = bool(cfg.home_triggers.match(path))
        if not trigger and cfg.home_ignore.match(path):
            ignored += 1
            continue
        group = home_group(cfg, path)
        if group:
            rank, key = group
        else:
            parts = path.split("/")
            key = f"{parts[0]}/{parts[1]}/" if len(parts) > 2 else path
            rank = len(cfg.HOME_GROUPS)
        first = f"{path} (deleted)" if kind == "d" else path
        entry = entries.setdefault(key, [rank, first, 0, False])
        entry[2] += 1
        entry[3] = entry[3] or trigger
    lines = []
    for key, (_, first, count, marked) in sorted(
            entries.items(), key=lambda e: (e[1][0], os.fsencode(e[0]))):
        if only_triggers and not marked:
            continue
        mark = "! " if marked else "  "
        lines.append(f"{mark}{first}" if count == 1 else f"{mark}{key} ({count} files)")
    if lines and not only_triggers and ignored:
        lines.append(f"  and {ignored} more in HOME_IGNORE (histories, caches...).")
    return "\n".join(lines)


CAN_RUN_CODE = "!: can run code, or steer the agent, in its later sessions."


def has_triggers(summary):
    return any(line.startswith("! ") for line in summary.split("\n"))


# --- The work dir: what the sandbox sees --------------------------------


def latest(times):
    """The latest of the times `find` printed with %C@; exactly."""
    return max(times, key=lambda t: tuple(map(int, t.split("."))), default="")


def host_triggers(cfg, path):
    """The triggers in `path`, as a set of (PATH, latest change time of
    their contents).  Change times (ctime), unlike modification times,
    cannot be set back by the sandbox.  The work dir itself isn't one,
    whatever its name."""
    found = set()
    for item in find(path, "-mindepth", "1", "(", *cfg.trigger_expr, ")", "-prune", "-print0"):
        name = os.path.basename(item)
        if name == ".git" and os.path.isdir(item):
            # Only what makes Git run code; the objects are data.
            starts = [f"{item}/config", f"{item}/hooks"]
            limit = []
        elif name in cfg.PRIVATE:
            # Build output can hold many files: existing ones are protected
            # and new ones are reported anyway, their path being new.
            starts, limit = [item], ["-maxdepth", "0"]
        else:
            starts, limit = [item], []
        found.add((item, latest(find(*starts, *limit, "-printf", "%C@\\0", quiet=True))))
    return found


@dataclasses.dataclass
class WorkDir:
    """What is known of the work dir, once protected."""
    path: str
    mount: str
    project: str
    shadowed: list = dataclasses.field(default_factory=list)
    # The paths read-only in the sandbox.
    ro_paths: list = dataclasses.field(default_factory=list)
    # The entries protected, out of the agent's reach, including the mount
    # points created for absent PRIVATE ones: changes to them are yours.
    protected: set = dataclasses.field(default_factory=set)
    # The mount points created in your tree, removed at exit.
    created: list = dataclasses.field(default_factory=list)

    def hidden(self):
        """What the sandbox doesn't see of it, as find tests: each .git
        (replaced by a clone) and the directories replaced by private
        copies.  The checks on the work dir skip them: hard links or sockets
        in a shadowed .venv, say, don't matter."""
        tests = ["-name", ".git"]
        for p in self.shadowed:
            tests += ["-o", "-path", glob_escape(p)]
        return ["(", *tests, ")", "-prune", "-o"]

    def outside_hardlinks(self):
        """Files that the sandbox can modify, with a hard link outside the
        work dir or to a read-only file in it: writing through the first name
        changes the others.  Files whose names in it are all read-only aren't
        reported.  One per line, made safe."""
        files = {}                      # inode -> [links, seen, writable, read-only]
        for entry in find(self.path, *self.hidden(), "-type", "f", "-links", "+1",
                          "-printf", "%D:%i %n %p\\0"):
            inode, links, path = entry.split(" ", 2)
            f = files.setdefault(inode, [int(links), 0, None, None])
            f[1] += 1
            if any(path == ro or path.startswith(f"{ro}/") for ro in self.ro_paths):
                f[3] = f[3] or path
            else:
                f[2] = f[2] or path
        lines = []
        for links, seen, writable, read_only in files.values():
            if writable is None:
                continue
            if seen < links:
                lines.append(safe(writable))
            elif read_only is not None:
                lines.append(f"{safe(writable)}  (same file as read-only {safe(read_only)})")
        return "\n".join(lines)

    def inner_mounts(self):
        """File systems mounted inside it (bwrap binds recursively), one per
        line, made safe.  findmnt -r writes each byte that isn't printable
        ASCII, the space and "\\" included, as \\xHH: decoded, or a work dir
        whose path holds one would match none."""
        out = capture(["findmnt", "-rn", "-o", "TARGET"]) or ""
        mounts = (os.fsdecode(re.sub(rb"\\x([0-9a-fA-F]{2})", lambda m: bytes([int(m[1], 16)]),
                                    os.fsencode(line))) for line in out.split("\n"))
        return "\n".join(safe(m) for m in mounts if m.startswith(f"{self.path}/"))

    def inner_sockets(self):
        """Unix sockets or named pipes in it, one per line, made safe.  They
        work across namespaces: the sandbox could talk to the host program
        listening on one, bypassing the firewall."""
        return "\n".join(map(safe, find(self.path, *self.hidden(),
                                        "(", "-type", "s", "-o", "-type", "p", ")", "-print0")))

    def outside_symlinks(self):
        """Symlinks in it resolving outside it, as a set of (LINK, TARGET),
        to compare: what is shown of two names can be the same."""
        found = set()
        for f in find(self.path, *self.hidden(), "-type", "l", "-print0"):
            if not inside(os.path.realpath(f), self.path):
                found.add((f, os.readlink(f)))
        return found

    def has_python_files(self):
        return bool(find(self.path, *self.hidden(), "-name", "*.py", "-print0", "-quit"))


def protect_repos(cfg, work, args):
    """Hide the real .git of each repo in the work dir behind a clone in
    the project's git/, and show the real one read-only under /upstream."""
    path, mount, project = work.path, work.mount, work.project

    # .git files (submodules, worktrees) and symlinks: their Git data is
    # elsewhere.  It stays hidden when it is outside the work dir or in a
    # protected .git, but is exposed when it is anywhere else in the work dir.
    for f in find(path, "-name", ".git", "(", "-type", "d", "-prune", "-o",
                  "(", "-type", "f", "-o", "-type", "l", ")", "-print0", ")"):
        repo = os.path.dirname(f)
        target = git_link_target(f)
        if target.endswith("/.git") or "/.git/" in target:
            warn(f"Not handled (submodule or worktree): {rel_to_pwd(repo)}")
        elif target == path or target.startswith(f"{path}/"):
            warn(f"{rel_to_pwd(f)} points to {rel_to_pwd(target)}, inside the work dir:")
            warn("  that repo's history, config and hooks are NOT protected.")
            if not confirm("  Continue anyway?"):
                raise Exit(1)
        else:
            warn(f"Not handled (Git data outside the work dir): {rel_to_pwd(repo)}")

    # Shallowest first, so that an enclosing repo is cloned before the
    # repos nested in it (Git refuses to clone into a non-empty dir).
    for g in git_repos(path):
        repo = g.removesuffix("/.git")
        rel = repo[len(path):].removeprefix("/")      # empty for the work dir itself
        copy = f"{project}/git/{rel}" if rel else f"{project}/git"
        # Where the sandbox sees your repo: /upstream mirrors the project,
        # with only the .git directories, read-only.  The clone records it
        # as its origin, so it must not change.
        upstream = f"/upstream/{rel}" if rel else "/upstream"

        print(f"Git {RED}{rel_to_pwd(repo)}{NORMAL} → {rel_to_home(copy)}")

        check_plain_config(g)

        # Hooks kept in the working tree (e.g. Husky's ".husky") are
        # writable by the sandbox and run at your next commit.
        hooks = capture(git_config(f"{g}/config", "core.hooksPath")) or ""
        if hooks not in ("", "/dev/null") and (
                not hooks.startswith("/") or hooks.startswith(f"{repo}/")):
            warn(f"  core.hooksPath is inside the work tree: review {safe(hooks)} after the session.")

        if not os.path.isdir(f"{copy}/.git"):
            # No copy yet: either a repo of yours seen for the first time,
            # or one the AI created in the shared tree in an earlier
            # session, whose configuration would be untrusted.
            if not confirm("  New repo: did you create it yourself?"):
                die(f"Not trusting {repo}.")
            os.makedirs(os.path.dirname(copy), exist_ok=True)
            # Cloning reads the source through upload-pack, which is safe
            # even in an untrusted repo.
            if subprocess.run(git("clone", "--no-local", "--no-checkout", "--quiet",
                                  "--", repo, copy)).returncode:
                raise Exit(1)
            # Safe: the copy was just created.  Fill its index from HEAD
            # (fails harmlessly on a repo without commits) and point its
            # origin at the read-only view of your repo in the sandbox.
            subprocess.run(git("-C", copy, "reset", "--quiet"), stderr=subprocess.DEVNULL)
            subprocess.run(git("-C", copy, "remote", "set-url", "origin", upstream))
            config = f"{g}/config"
            subprocess.run(git_config(config, "--remove-section", "remote.ai"),
                           stderr=subprocess.DEVNULL)
            subprocess.run(git_config(config, "remote.ai.url", copy))
            subprocess.run(git_config(config, "remote.ai.fetch", "+refs/heads/*:refs/remotes/ai/*"))
            subprocess.run(git_config(config, "remote.ai.tagOpt", "--no-tags"))
            subprocess.run(git_config(config, "fetch.fsckObjects", "true"))

        args += ["--bind", f"{copy}/.git", f"{mount}/{g[len(path) + 1:]}",
                 "--ro-bind", g, f"{upstream}/.git"]


def protect_tool_files(cfg, work, args):
    """In the sandbox, replace the PRIVATE entries of the work dir by
    private copies kept in the project's shadow/, and make the READONLY
    ones read-only.  Symlinks are skipped: a mount on one would land
    wherever it points in the sandbox."""
    path, mount = work.path, work.mount
    shadow_base = f"{work.project}/shadow"
    names = name_tests([*cfg.PRIVATE, *cfg.READONLY])
    found = names and find(path, "-mindepth", "1", "-name", ".git", "-prune", "-o",
                           "(", *names, ")",
                           "(", "-type", "d", "-o", "-type", "f", ")", "-prune", "-print0")
    # PRIVATE entries the project's tools would create at the top.
    for name, signal_file in cfg.PRIVATE_IF.items():
        p = f"{path}/{name}"
        if not os.path.lexists(p) and os.path.exists(f"{path}/{signal_file}"):
            found.append(p)
            work.created.append(p)

    for p in found:
        rel = p[len(path) + 1:]
        if os.path.basename(p) in cfg.PRIVATE:
            # A file named like a PRIVATE directory is left alone.
            if os.path.exists(p) and not os.path.isdir(p):
                continue
            # Create the mount point ourselves: bwrap couldn't if the work
            # dir is read-only in the sandbox (--ro .).
            if not os.path.exists(p):
                os.mkdir(p)
            os.makedirs(f"{shadow_base}/{rel}", exist_ok=True)
            args += ["--bind", f"{shadow_base}/{rel}", f"{mount}/{rel}"]
            work.shadowed.append(p)
            warn(f"Private in the sandbox: {RED}{rel_to_pwd(p)}{NORMAL}")
        else:
            args += ["--ro-bind", p, f"{mount}/{rel}"]
            work.ro_paths.append(p)
            warn(f"Read-only in the sandbox: {RED}{rel_to_pwd(p)}{NORMAL}")
        work.protected.add(p)


def protect_read_only(cfg, work, patterns, args):
    """Make what matches `patterns` (see --ro) read-only in the sandbox.
    Only what exists now is protected: files matching a pattern that the
    agent creates later are writable.  The .git and PRIVATE directories are
    skipped: the sandbox sees a clone or a private copy there.  Symlinks are
    skipped too: a mount on one would land wherever it points in the sandbox."""
    path, mount = work.path, work.mount
    skip = name_tests([".git", *cfg.PRIVATE])
    total = 0
    for pat in patterns:
        if pat.startswith("/"):
            # An absolute path or pattern must be in the work dir.
            if not f"{pat}/".startswith(f"{path}/"):
                die(f"--ro: {pat} is not in the work dir ({path}).")
            pat = pat[len(path):].removeprefix("/") or "."
        pat = pat.removesuffix("/").removeprefix("./")
        if pat in (".", ""):
            found = [path]
        else:
            # find's -path takes a pattern: escape the work dir's own path.
            test = (["-path", f"{glob_escape(path)}/{pat}"] if "/" in pat else ["-name", pat])
            found = find(path, "-mindepth", "1", "(", *skip, ")", "-prune", "-o",
                         *test, "-prune", "-print0")
        kept = []
        for p in found:
            if os.path.islink(p):
                warn(f"--ro: symlink skipped: {rel_to_pwd(p)}")
                continue
            args += ["--ro-bind", p, mount if p == path else f"{mount}/{p[len(path) + 1:]}"]
            work.ro_paths.append(p)
            kept.append(p)
        if not kept:
            warn(f"--ro: nothing matches '{safe(pat)}' in the current dir.")
        elif len(kept) <= 3:
            for p in kept:
                warn(f"Read-only in the sandbox: {RED}{rel_to_pwd(p)}{NORMAL}")
        else:
            warn(f"Read-only in the sandbox: {len(kept)} entries matching "
                 f"{RED}'{safe(pat)}'{NORMAL}.")
        total += len(kept)
    # Each entry is a mount; a great many slow the sandbox's start.
    if total > 2000:
        warn(f"--ro: {total} read-only mounts; a pattern on a directory would need fewer.")


def seccomp_filter():
    """A file descriptor of the seccomp filter for the sandbox: block kernel
    interfaces programs can do without, and that have a long record of
    exploited bugs.  The filter only covers 64-bit system calls: 32-bit
    ones (i386, x32) kill the process."""
    import seccomp

    f = seccomp.SyscallFilter(seccomp.ALLOW)

    def deny(err, *names, args=()):
        for name in names:
            try:
                f.add_rule(seccomp.ERRNO(err), name, *args)
            except (OSError, RuntimeError, ValueError):
                pass                    # not on this architecture

    # Programs fall back to classic I/O when io_uring is missing.
    deny(errno.ENOSYS, "io_uring_setup", "io_uring_enter", "io_uring_register")
    deny(errno.EPERM, "bpf", "userfaultfd", "perf_event_open",
         "keyctl", "add_key", "request_key")
    # Refused anyway without privileges: no need to reach that code.
    deny(errno.EPERM, "mount", "umount2", "pivot_root", "mount_setattr",
         "move_mount", "open_tree", "fsopen", "fsconfig", "fsmount", "fspick")
    # Typing into the terminal (TIOCSTI) or the Linux console (TIOCLINUX).
    for request in (0x5412, 0x541C):
        deny(errno.EPERM, "ioctl",
             args=(seccomp.Arg(1, seccomp.MASKED_EQ, 0xFFFFFFFF, request),))
    # Socket families: only Unix, IPv4, IPv6 and netlink (name resolution).
    # The kernel only reads the low 32 bits of the family, hence the final
    # rule: it also catches values with high bits set.
    allowed = {1, 2, 10, 16}
    for family in range(64):
        if family not in allowed:
            deny(errno.EAFNOSUPPORT, "socket",
                 args=(seccomp.Arg(0, seccomp.EQ, family),))
    deny(errno.EAFNOSUPPORT, "socket", args=(seccomp.Arg(0, seccomp.GE, 64),))

    fd = os.memfd_create("seccomp.bpf")
    with os.fdopen(fd, "wb", closefd=False) as out:
        f.export_bpf(out)
    os.lseek(fd, 0, os.SEEK_SET)
    return fd


# Both the firewall and slirp4netns must act from the user namespace
# that owns the sandbox's network namespace, where they have the rights
# to configure it.  bwrap moves the sandbox itself into a namespace
# nested in that one, at a time we can't know.  JOIN_NS PID [net] CMD...
# asks the kernel for the owner (ioctl NS_GET_USERNS on the network
# namespace), joins it, and the network namespace too with "net", then
# runs CMD, keeping your credentials.  Python's own file descriptors
# aren't passed on to CMD.  In a process of its own: joining a user
# namespace needs a single thread, and this program has several.
JOIN_NS = '''
import fcntl, os, sys, time
NS_GET_USERNS = 0xb701                  # linux/nsfs.h
pid, where, *cmd = sys.argv[1:]
# bwrap reports the PID before the sandbox has mapped your user in its
# namespace: joining it earlier would give no rights there.  Once the
# sandbox is nested, its own namespace is mapped, its parent long before.
for _ in range(500):
    with open(f"/proc/{pid}/uid_map") as uid_map:
        if uid_map.read().strip():
            break
    time.sleep(0.01)
net = os.open(f"/proc/{pid}/ns/net", os.O_RDONLY)
os.setns(fcntl.ioctl(net, NS_GET_USERNS), os.CLONE_NEWUSER)
if where == "net":
    os.setns(net, os.CLONE_NEWNET)
os.execvp(cmd[0], cmd)
'''

SLIRP_NOISE = re.compile(rb"(sent tapfd=[0-9]+ for tap0|received tapfd=[0-9]+)\n?")


def background(target, *args):
    thread = threading.Thread(target=target, args=args, daemon=True)
    thread.start()
    return thread


@dataclasses.dataclass
class Session:
    """A session and what is needed to end it."""
    cfg: Config
    nft: str
    ssh: bool
    read_only: list
    cmd: list
    work: WorkDir = None
    tmp: str = None
    home_args: tuple = ()
    bwrap: subprocess.Popen = None
    agent_pid: int = None
    # The network: slirp4netns, once started, unless the session is ending.
    slirp: subprocess.Popen = None
    network_lock: threading.Lock = dataclasses.field(default_factory=threading.Lock)
    network_ending: bool = False
    network_thread: threading.Thread = None
    # New tool files, as they appear.
    watch: subprocess.Popen = None
    watch_reader: threading.Thread = None
    # The agent's events: ai holds the pipe open for writing for the whole
    # session, so that a hook never waits for a reader, and the reader sees
    # no end of file when a hook closes it: only at the end.
    events_writer: int = None
    events_reader: threading.Thread = None
    # The snapshots for the checks at exit, once the sandbox is about to start.
    symlinks_before: set = None
    triggers_before: set = None
    home_before: set = None
    home_watch: tuple = ()

    # --- During the session ---------------------------------------------

    def report_trigger(self, path):
        """A new TRIGGERS entry `path` appeared in the work dir.  Log it and,
        when possible, show a desktop notification."""
        cfg, top = self.cfg, self.work.path
        shown = safe(path)
        where = safe(f"{os.path.basename(top)}/{path.removeprefix(f'{top}/')}")
        try:
            with open(cfg.AI_LOG, "a", **ENCODING) as log:
                log.write(f"{timestamp()} New during the session in {safe(top)}: {shown}\n")
        except OSError:
            pass
        notify("-a", "ai", "-u", "critical", "-i",
               find_icon("ai-sandbox-warning", "dialog-warning"),
               f"ai: new {os.path.basename(shown)}",
               valid_utf8(f"{markup(where)} was just created, by you or the agent. "
                          "Review it before using the project on your machine."))

    def watch_triggers(self):
        """Read the events of inotifywait, NUL-separated "EVENTS<TAB>PATH",
        and report the new TRIGGERS entries in the work dir."""
        cfg, seen = self.cfg, set(self.work.protected)
        data = b""
        while chunk := self.watch.stdout.read1(65536):
            *events, data = (data + chunk).split(b"\0")
            for event in events:
                kind, _, path = os.fsdecode(event).partition("\t")
                found = [path] if os.path.basename(path) in cfg.TRIGGERS else []
                if "ISDIR" in kind:
                    # A new directory, or one moved in: inotifywait only watches
                    # it once it exists, so what is created in it before is missed.
                    try:
                        found += find(path, "-mindepth", "1", "(", *cfg.trigger_expr, ")",
                                      "-prune", "-print0", quiet=True)
                    except OSError:
                        pass            # the report at exit still covers it
                for p in found:
                    if p not in seen:
                        seen.add(p)
                        self.report_trigger(p)

    def start_watch(self):
        """Watch the work dir for new TRIGGERS entries until the end.  Returns
        once the watches are set, so that nothing the sandbox creates is missed."""
        cfg = self.cfg
        # The contents of .git and of the PRIVATE directories don't matter
        # (your own builds there would only cost watches): only entries
        # appearing in them.  The names only need their dots escaped.
        exclude = "|".join(n.replace(".", r"\.") for n in [".git", *cfg.PRIVATE])
        log = f"{self.tmp}/watch.log"
        with open(log, "wb") as errors:
            self.watch = subprocess.Popen(
                ["inotifywait", "-m", "-r", "-e", "create", "-e", "moved_to",
                 "--exclude", f"/({exclude})/", "--format", "%e\t%w%f%0", "--no-newline",
                 self.work.path],
                stdout=subprocess.PIPE, stderr=errors, stdin=subprocess.DEVNULL)
        self.watch_reader = background(self.watch_triggers)
        # inotifywait says so once all the watches are set; on a large tree
        # it takes a while.
        for _ in range(300):
            with open(log, "rb") as f:
                text = f.read()
            if re.search(rb"^Watches established", text, re.M):
                return
            if self.watch.poll() is not None:
                break
            time.sleep(0.1)
        warn(f"Watching for new tool files failed or is slow: see {safe(log)}.")
        with open(log, "rb") as f:
            for line in os.fsdecode(f.read()).split("\n"):
                if re.search("error|failed|limit", line, re.I):
                    warn(safe(line))

    def watch_agent_events(self, fd, name):
        """Read the events the agent reports (the pipe $AI_NOTIFY), one word
        per line, and show a notification about the session `name` for those
        of AGENT_EVENTS, at most one of each every 5 seconds, so that the
        agent can't flood your desktop.  Words are cut at 32 bytes: the rest
        is read as another one."""
        cfg, last = self.cfg, {}
        name = valid_utf8(safe(name))   # a title: not markup
        icon = find_icon("ai-sandbox", "dialog-information")
        data = b""
        while chunk := os.read(fd, 4096):
            data += chunk
            while True:
                end = data.find(b"\n", 0, 33)
                if end >= 0:
                    word, data = data[:end], data[end + 1:]
                elif len(data) >= 32:
                    word, data = data[:32], data[32:]
                else:
                    break
                event = word.decode("ascii", "replace")
                if event not in cfg.AGENT_EVENTS or not re.fullmatch("[a-z_]+", event):
                    continue
                now = time.monotonic()
                if now - last.get(event, now - 5) < 5:
                    continue
                last[event] = now
                notify("--hint=boolean:transient:true", "-a", "ai", "-i", icon,
                       f"ai: {name}", f"The agent {cfg.AGENT_EVENTS[event]}.")

    def start_agent_events(self):
        fifo = f"{self.tmp}/notify"
        # Non-blocking only to open it, as each open otherwise waits for the other.
        reader = os.open(fifo, os.O_RDONLY | os.O_NONBLOCK)
        self.events_writer = os.open(fifo, os.O_WRONLY)
        os.set_blocking(reader, True)
        name = os.path.basename(self.work.path) if self.work else "the agent's home"
        self.events_reader = background(self.watch_agent_events, reader, name)

    # --- The network ----------------------------------------------------
    #
    # slirp4netns rather than --share-net: sharing the host's network
    # namespace would let the sandbox reach services listening on the
    # host's localhost (databases, dev servers, CUPS...).

    def setup_network(self, info, block):
        """Wait for bwrap to report the sandbox's PID, then attach the network
        to it.  Once slirp4netns says it's ready, release bwrap, through the
        descriptor `block`.  If anything else happens, kill the sandbox: bwrap
        would otherwise wait forever."""
        pid = None
        try:
            with os.fdopen(info, "rb") as lines:
                for line in lines:
                    if match := re.search(rb'"child-pid": *([0-9]+)', line):
                        pid = int(match[1])
                        break
                # bwrap goes on writing to the pipe: closing it would kill
                # bwrap (SIGPIPE).  Read the rest, until bwrap closes it.
                info_rest = os.dup(lines.fileno())
            background(self.drain, info_rest)
            if pid is None:
                return
            # Firewall in the sandbox's network namespace, set as root of the
            # namespace that owns it: the sandbox cannot change it.
            if subprocess.run([self.cfg.PYTHON, "-I", "-c", JOIN_NS, str(pid), "net",
                               self.nft, "-f", "-"],
                              input=self.cfg.NFT_RULES.encode(**ENCODING)).returncode:
                self.network_failed("could not install the firewall rules", pid)
                return
            ready_r, ready_w = os.pipe()
            errors_r, errors_w = os.pipe()
            with self.network_lock:
                if self.network_ending:
                    return
                self.slirp = subprocess.Popen(
                    [self.cfg.PYTHON, "-I", "-c", JOIN_NS, str(pid), "user",
                     "slirp4netns", "--configure", "--mtu=65520", "--disable-host-loopback",
                     "--enable-sandbox", "--enable-seccomp",
                     f"--ready-fd={ready_w}", "--netns-type=path", f"/proc/{pid}/ns/net", "tap0"],
                    pass_fds=(ready_w,), stdin=subprocess.DEVNULL,
                    stdout=subprocess.DEVNULL, stderr=errors_w)
            os.close(ready_w)
            os.close(errors_w)
            background(self.show_slirp_errors, errors_r)
            # slirp4netns writes "1" when ready; it closes the pipe if it fails.
            if not os.read(ready_r, 1):
                self.network_failed("slirp4netns stopped", pid)
                return
            os.close(ready_r)
            os.write(block, b"\n")
        except Exception as e:
            self.network_failed(str(e), pid)

    @staticmethod
    def drain(fd):
        with os.fdopen(fd, "rb") as f:
            while f.read(65536):
                pass

    @staticmethod
    def show_slirp_errors(fd):
        with os.fdopen(fd, "rb") as lines:
            for line in lines:
                if not SLIRP_NOISE.fullmatch(line):
                    sys.stderr.write(safe_text(os.fsdecode(line)))

    def network_failed(self, reason, pid):
        with self.network_lock:
            if self.network_ending:
                return
        warn(f"ai: network setup failed: {safe(reason)}")
        # Otherwise bwrap waits on the block pipe forever.
        for victim in (pid, self.bwrap.pid):
            if victim is not None:
                try:
                    os.kill(victim, signal.SIGKILL)
                except OSError:
                    pass

    # --- The end --------------------------------------------------------

    def report(self, links, triggers, home_summary):
        """The report at exit on the session, with `home_summary`, a summary
        of the changes to the agent's home."""
        cfg, work = self.cfg, self.work
        lines = [f"{timestamp()} Session in {safe(work.path if work else cfg.AIHOME)}:"]
        if links:
            lines.append("New symlinks out of the work dir (don't follow them blindly):")
            lines += [f"  {line}" for line in links]
        if triggers:
            lines.append("New or changed files that can run code on the host (review before")
            lines.append("entering these directories, opening them in an editor or running")
            lines.append("Git, npm, Cargo... there):")
            lines += [f"  {line}" for line in triggers]
        if home_summary:
            if work:
                where = rel_to_home(f"{work.project}/home")
                lines.append(f"Changed in the agent's home, in this project only (in {where}):")
            else:
                lines.append("Changed in the agent's base home, seen by every project "
                             f"(in {rel_to_home(cfg.AIHOME)}):")
            lines.append(home_summary)
            if has_triggers(home_summary):
                lines.append(CAN_RUN_CODE)
            if work:
                lines.append("Once reviewed, ai --promote PATH in the project makes one "
                             "the base version.")
        return "\n".join(lines) + "\n"

    def stop_process(self, proc):
        if proc is None or proc.poll() is not None:
            return
        proc.terminate()
        try:
            proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait()

    def stop_everything(self):
        # What the report at exit covers must have ended: it could go on
        # changing the work dir.  (--die-with-parent is for when ai can't do it.)
        self.stop_process(self.bwrap)
        with self.network_lock:
            self.network_ending = True
            slirp = self.slirp
        self.stop_process(slirp)
        if self.network_thread:
            self.network_thread.join(timeout=5)
        if self.agent_pid:
            try:
                os.kill(self.agent_pid, signal.SIGTERM)
            except OSError:
                pass
        if self.watch:
            self.stop_process(self.watch)
            self.watch_reader.join(timeout=5)
        if self.events_writer is not None:
            # Without ai's end, the reader shows what is left in the pipe,
            # then sees its end: the hooks went with the sandbox.  Unless
            # something still holds it, after a signal: it is left, then, as
            # it ends with ai.
            os.close(self.events_writer)
            self.events_reader.join(timeout=2)

    def write_reports(self):
        cfg, work = self.cfg, self.work
        links, triggers = [], []
        if self.symlinks_before is not None and self.triggers_before is not None:
            links = sorted((f"{rel_to_pwd(f)} → {safe(target)}" for f, target in
                            work.outside_symlinks() - self.symlinks_before), key=os.fsencode)
            new = host_triggers(cfg, work.path) - self.triggers_before
            triggers = [safe(p) for p in sorted({p for p, _ in new} - work.protected,
                                                key=os.fsencode)]
        # The changes to the agent's home: all of them on the terminal, only
        # those that can run code or steer the agent in the log.
        home_all = home_warn = ""
        if self.home_before is not None:
            changes = sorted(home_snapshot(*self.home_watch) - self.home_before)
            changes = [(kind, path) for kind, _, path in changes]
            home_all = summarize_home(cfg, changes)
            home_warn = summarize_home(cfg, changes, only_triggers=True)
        if links or triggers or home_warn:
            # Not writable: the report on the terminal must still come.
            try:
                with open(cfg.AI_LOG, "a", **ENCODING) as log:
                    log.write(self.report(links, triggers, home_warn))
            except OSError as e:
                warn(f"ai: {safe(cfg.AI_LOG)}: {e.strerror}.")
        if links or triggers or home_all:
            sys.stderr.write(self.report(links, triggers, home_all))
            sys.stderr.flush()

    def cleanup(self):
        """Whatever went wrong before, or goes wrong here, each step runs."""
        for sig in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
            signal.signal(sig, signal.SIG_IGN)

        def created_mount_points():
            # Mount points created in your tree for absent PRIVATE entries.
            for p in self.work.created if self.work else ():
                try:
                    os.rmdir(p)
                except OSError:
                    pass

        for step in (self.stop_everything, created_mount_points, self.write_reports):
            try:
                step()
            except Exception as e:
                try:
                    warn(f"ai: {safe(str(e))}")
                except OSError:
                    pass                # no terminal any more
        if self.tmp:
            shutil.rmtree(self.tmp, ignore_errors=True)


def check_session_tools(cfg):
    if not os.path.isdir(cfg.AIHOME):
        die(f"Create the directory '{cfg.AIHOME}' with minimal configuration files.")
    if not os.access(cfg.BWRAP, os.X_OK):
        die("bubblewrap is not installed (e.g. 'apt install bubblewrap').")
    p = subprocess.run([cfg.BWRAP, "--help"], stdout=subprocess.PIPE,
                       stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL)
    if b"--overlay-src" not in p.stdout:
        die("bubblewrap is too old: version 0.10 or later is needed (--overlay).")
    if not shutil.which("slirp4netns"):
        die("slirp4netns is not installed (e.g. 'apt install slirp4netns').")
    if not shutil.which("findmnt"):
        die("findmnt is missing (e.g. 'apt install util-linux').")
    if not shutil.which("systemd-escape"):
        die("systemd-escape is missing (it comes with systemd).")
    nft = shutil.which("nft", path=f"{os.environ.get('PATH', '')}:/usr/sbin:/sbin")
    if not nft:
        die("nft is not installed (e.g. 'apt install nftables').")
    try:
        import seccomp  # noqa: F401
    except ImportError:
        die("libseccomp's Python bindings are missing (e.g. 'apt install python3-seccomp').")
    return nft


def check_work_path(cfg, work_path, home):
    if work_path == "/":
        die("Refusing to expose the whole file system.")
    if f"{home}/".startswith(f"{work_path}/"):
        die(f"Refusing to expose your whole home directory ({work_path}).")
    if f"{work_path}/".startswith(f"{home}/."):
        die(f"Refusing to expose configuration files ({work_path}).")
    # Where ai's own files are, wherever your configuration put them.
    for p in (cfg.AIHOME, cfg.PROJECTS, cfg.LOCKDIR, cfg.AI_LOG, *cfg.files, cfg.AI_SSH_KEY):
        if overlaps(work_path, p):
            die(f"Refusing to expose the sandbox's own files ({p}).")
    for p in cfg.FORBID_WORK:
        if overlaps(work_path, p):
            die(f"Refusing to expose {p} (FORBID_WORK).")


def warn_about_pycache(cfg, work):
    # Python on your machine would otherwise use the bytecode (.pyc) the
    # agent can leave in __pycache__ directories next to the sources.  A
    # relative value (Python doesn't expand "~") is resolved against the
    # directory Python runs in, possibly the work dir.
    if not work.has_python_files():
        return
    prefix = os.environ.get("PYTHONPYCACHEPREFIX", "")
    pycache = os.path.realpath(prefix) if prefix.startswith("/") else work.path
    if inside(pycache, work.path) or inside(pycache, cfg.AIHOME) or inside(pycache, cfg.PROJECTS):
        warn("Warning: PYTHONPYCACHEPREFIX is not an absolute path outside the work dir "
             "and the agent's directories:")
        warn("  Python on your machine would use the bytecode the agent leaves in __pycache__.")
        warn('  Set it in your shell profile, e.g. export PYTHONPYCACHEPREFIX="$HOME/.cache/pycache"')


def confirm_warnings(work):
    """What must be confirmed: the checks on what the sandbox will see of
    the work dir, after protect_tool_files, which says what it replaces."""
    for message, lines in (
            ("Hard-linked outside the work dir, or to read-only files in it "
             "(the sandbox could modify them through these):", work.outside_hardlinks()),
            ("File systems mounted inside the work dir (exposed too):", work.inner_mounts()),
            ("Unix sockets or named pipes in the work dir (the sandbox could talk "
             "to the programs behind them):", work.inner_sockets())):
        if lines:
            warn(message)
            sys.stderr.write(indent(lines))
            if not confirm("Continue anyway?"):
                raise Exit(1)


def sandbox_args(session, env):
    """The arguments of bwrap, up to what depends on the work dir."""
    tmp, home = session.tmp, os.environ["HOME"]
    args = [
        "--die-with-parent",
        "--new-session",
        "--unshare-all",

        "--clearenv",
        "--setenv", "PATH", "/usr/bin:/bin",
        "--setenv", "TERM", env.get("TERM", ""),
        "--setenv", "LANG", env.get("LANG") or "C.UTF-8",

        "--dev", "/dev",
        "--proc", "/proc",
        "--tmpfs", "/tmp",

        "--ro-bind", "/usr", "/usr",
        "--ro-bind", "/lib", "/lib",
        "--ro-bind-try", "/lib64", "/lib64",
        "--ro-bind", "/bin", "/bin",
        "--ro-bind-try", "/var/lib/texmf", "/var/lib/texmf",
        "--ro-bind-try", "/etc/alternatives", "/etc/alternatives",
        "--ro-bind-try", "/etc/emacs/site-start.d", "/etc/emacs/site-start.d",
        "--ro-bind", f"{tmp}/resolv.conf", "/etc/resolv.conf",
        "--ro-bind", "/etc/hosts", "/etc/hosts",
        "--ro-bind", "/etc/ssl", "/etc/ssl",
        "--ro-bind", f"{tmp}/passwd", "/etc/passwd",
        "--ro-bind", f"{tmp}/group", "/etc/group",
        "--ro-bind-try", "/etc/localtime", "/etc/localtime",
        "--ro-bind-try", "/etc/ld.so.cache", "/etc/ld.so.cache",
        "--ro-bind", f"{tmp}/nsswitch.conf", "/etc/nsswitch.conf",
        "--unshare-user",
        # Forbid using `unshare -U` to gain full capabilities in a fresh
        # namespace.
        "--disable-userns",
        *session.home_args,
        "--ro-bind-try", f"{home}/texmf", f"{home}/texmf",
        "--setenv", "HOME", home,
        "--setenv", "USER", env.get("USER", ""),
        # Keep the sandbox's Python bytecode out of the work dir.
        "--setenv", "PYTHONPYCACHEPREFIX", f"{home}/.cache/pycache",
        # The pipe of the agent's events (see watch_agent_events).
        "--bind", f"{tmp}/notify", "/run/ai/notify",
        "--setenv", "AI_NOTIFY", "/run/ai/notify",
    ]
    if session.ssh:
        args += [
            # Your known hosts, as the system's: a mount point in the agent's
            # home would be a change to it (in each project's layer).
            "--ro-bind-try", f"{home}/.ssh/known_hosts", "/etc/ssh/ssh_known_hosts",
            "--bind", f"{tmp}/agent.sock", "/run/ssh-agent.sock",
            "--setenv", "SSH_AUTH_SOCK", "/run/ssh-agent.sock",
        ]
    return args


def start_ssh_agent(session):
    """A private agent holding only the AI's key; it ends with ai."""
    cfg = session.cfg
    sock = f"{session.tmp}/agent.sock"
    out = capture(["ssh-agent", "-s", "-a", sock]) or ""
    match = re.search(r"^SSH_AGENT_PID=([0-9]+);", out, re.M)
    if not match:
        die("--ssh: could not start ssh-agent.")
    session.agent_pid = int(match[1])
    hosts = [word for h in cfg.AI_SSH_HOSTS for word in ("-h", h)]
    try:
        with open("/dev/tty", "rb") as tty:
            failed = subprocess.run(["ssh-add", "-q", *hosts, cfg.AI_SSH_KEY], stdin=tty,
                                    env=dict(os.environ, SSH_AUTH_SOCK=sock)).returncode
    except OSError:
        failed = True
    if failed:
        die(f"--ssh: could not load {cfg.AI_SSH_KEY}.")


def write_host_files(tmp):
    def write(name, text):
        with open(f"{tmp}/{name}", "w", **ENCODING) as f:
            f.write(text)

    # slirp4netns provides a DNS forwarder at 10.0.2.3.
    write("resolv.conf", "nameserver 10.0.2.3\n")
    for name, key in (("passwd", os.getuid()), ("group", os.getgid())):
        entry = capture(["getent", name, str(key)])
        write(name, f"{entry}\n" if entry else "")
    write("nsswitch.conf", "passwd: files\ngroup: files\nhosts: files dns\n")


def run_session(session, env, work_path):
    """Set up the sandbox and run it; the status of the session."""
    cfg = session.cfg
    session.tmp = tempfile.mkdtemp(prefix="ai.")
    write_host_files(session.tmp)
    os.mkfifo(f"{session.tmp}/notify")
    # The block pipe is opened read-write: read-only would wait for a writer.
    # ai and bwrap sharing it, it never sees an end of file, which would
    # release the sandbox.
    os.mkfifo(f"{session.tmp}/block")
    block = os.open(f"{session.tmp}/block", os.O_RDWR)
    try:
        seccomp_fd = seccomp_filter()
    except Exception:
        die("Could not build the seccomp filter.")
    if session.ssh:
        start_ssh_agent(session)

    if work_path:
        project = session.work.project
        # The base home read-only, under the project's own changes.  The
        # work directory must be on the same file system as the changes.
        os.makedirs(f"{project}/home", exist_ok=True)
        os.makedirs(f"{project}/home.work", exist_ok=True)
        session.home_args = ("--overlay-src", cfg.AIHOME,
                             "--overlay", f"{project}/home", f"{project}/home.work", env["HOME"])
    else:
        session.home_args = ("--bind", f"{cfg.AIHOME}/", f"{env['HOME']}/")
    args = sandbox_args(session, env)

    if work_path:
        work = session.work
        args += [
            "--bind", work.path, work.mount,
            "--chdir", work.mount,
            # For the files of the base home, shared by all sessions, to tell
            # a project session (e.g. in .bashrc: [ -n "$AI_PROJECT" ]).
            "--setenv", "AI_PROJECT", work.mount,
        ]
        # Before the other mounts in the work dir: a read-only bind of a
        # directory would otherwise cover the clones and private copies
        # mounted inside it, and expose what they hide.
        if session.read_only:
            protect_read_only(cfg, work, session.read_only, args)
        protect_repos(cfg, work, args)
        protect_tool_files(cfg, work, args)
        confirm_warnings(work)
        warn_about_pycache(cfg, work)
        # Snapshots for the checks at exit, taken after protect_repos, whose
        # changes to the repos' config must not be reported.
        session.symlinks_before = work.outside_symlinks()
        session.triggers_before = host_triggers(cfg, work.path)
        # Report new tool files as they appear, not only at exit.
        if shutil.which("inotifywait"):
            session.start_watch()
            if not shutil.which("notify-send"):
                warn("notify-send is missing: new tool files are only logged "
                     "(e.g. 'apt install libnotify-bin').")
        else:
            warn("inotifywait is missing: new tool files are only reported at exit "
                 "(e.g. 'apt install inotify-tools').")
    else:
        # No work directory, e.g. to install packages or AI tools in $HOME.
        warn("No work directory: the sandbox starts in the agent's home (-w to work here).")
        args += ["--chdir", env["HOME"]]

    # Allocate a pseudo-terminal for bash (so one has job control with
    # Ctrl-Z, fg, bg):
    cmd = session.cmd or ["script", "-qc", "bash -i", "/dev/null"]

    session.start_agent_events()

    # For the report at exit on the agent's home: in a project, its whole
    # layer (its changes); otherwise, the HOME_TRIGGERS of the base home.
    if work_path:
        session.home_watch = (f"{session.work.project}/home",)
    else:
        session.home_watch = (cfg.AIHOME, cfg.HOME_TRIGGERS)
    session.home_before = home_snapshot(*session.home_watch)

    # Your environment variables, as --setenv arguments that bwrap reads
    # from a file in memory, to keep them off its command line.
    env_fd = os.memfd_create("env")
    for entry in cfg.AI_ENV + (cfg.AI_PROJECT_ENV if work_path else []):
        name, _, value = entry.partition("=")
        os.write(env_fd, os.fsencode(f"--setenv\0{name}\0{value}\0"))
    os.lseek(env_fd, 0, os.SEEK_SET)

    info_r, info_w = os.pipe()
    # By this thread, for good: --die-with-parent is about the thread that
    # started it, which would otherwise take the sandbox with it at its end.
    session.bwrap = subprocess.Popen(
        [cfg.BWRAP, "--info-fd", str(info_w), "--block-fd", str(block),
         "--seccomp", str(seccomp_fd), *args, "--args", str(env_fd), *cmd],
        pass_fds=(info_w, block, seccomp_fd, env_fd))
    os.close(info_w)
    session.network_thread = background(session.setup_network, info_r, block)
    status = session.bwrap.wait()
    return 128 - status if status < 0 else status


# --- Commands on projects -----------------------------------------------


def find_project(cfg):
    """The project containing the current directory, if any."""
    try:
        d = os.path.realpath(".", strict=True)
    except OSError:
        return None
    while not os.path.isfile(f"{project_dir(cfg, d)}/path"):
        if d == "/":
            return None
        d = os.path.dirname(d)
    return d


def show_home_layer(cfg, layer):
    """Sum up the changes in `layer`, a project's layer of the agent's
    home, if any.  Overlayfs records deletions as whiteouts: character
    devices.  Silent: the agent may leave unreadable directories."""
    found = find(layer, "-mindepth", "1",
                 "(", "-type", "c", "-printf", "d %P\\0",
                 "-o", "!", "-type", "d", "-printf", "f %P\\0", ")", quiet=True)
    summary = summarize_home(cfg, [tuple(entry.split(" ", 1)) for entry in found])
    if not summary:
        return
    print(f"Home layer: {du(layer)}, changes to the agent's home:")
    print(summary)
    if has_triggers(summary):
        print(CAN_RUN_CODE)


def show_repo_status(path, copy, rel):
    """Show what the clone `copy` has that your repo `path` hasn't; how many
    branches.  ls-remote, like fetch, runs no code from the clone.  Never
    run Git inside the clones."""
    shown = safe(rel or ".")
    if not os.path.isdir(f"{path}/.git"):
        print(f"Repo {RED}{shown}{NORMAL}: gone from the project (its clone is kept)")
        # The clone may hold the only copy of the agent's commits.
        return 1
    heads = capture(git("-C", path, "ls-remote", "--heads", "--", copy),
                    stderr=subprocess.DEVNULL)
    if heads is None:
        print(f"Repo {RED}{shown}{NORMAL}: cannot read its clone")
        return 0
    unmerged = 0
    for line in heads.split("\n"):
        sha, _, name = line.partition("\t")
        # Git gives a null ID for the refs it finds invalid.
        if not re.fullmatch("[0-9a-f]{40}([0-9a-f]{24})?", sha) or not sha.strip("0"):
            continue
        name = safe(f"ai/{name.removeprefix('refs/heads/')}")
        if subprocess.run(git("-C", path, "cat-file", "-e", f"{sha}^{{commit}}"),
                          stderr=subprocess.DEVNULL).returncode:
            what = "new commits, not fetched yet (git fetch ai)"
        else:
            count = int(capture(git("-C", path, "rev-list", "--count", sha,
                                    "--not", "--branches", "--")) or 0)
            if not count:
                continue
            what = f"{'1 commit' if count == 1 else f'{count} commits'} not in your branches"
        if not unmerged:
            print(f"Repo {RED}{shown}{NORMAL}:")
        print(f"  {name}: {what}")
        unmerged += 1
    if not unmerged:
        print(f"Repo {RED}{shown}{NORMAL}: nothing left to merge")
    return unmerged


def show_status(cfg, path=None):
    """What ai keeps for the project `path`, by default the one containing
    the current directory (the project root may be a super-directory).  The
    branch names and paths it shows are made safe: they come from the agent.
    Returns the number of branches holding commits you don't have."""
    if path is None:
        path = find_project(cfg)
        if path is None:
            die("No project here: ai -w makes the current directory one.")
    project = project_dir(cfg, path)
    print(f"Project: {rel_to_home(path)}{'' if os.path.isdir(path) else ' (gone)'}")
    print(f"Kept in: {rel_to_home(project)} ({du(project)})")
    lock = session_lock(cfg, path)
    if os.path.exists(lock) and is_locked(lock):
        print(f"Session: running since {timestamp(os.path.getmtime(lock))}")
    else:
        print("Session: none")

    # The clones' branches, from your repos.
    unmerged = 0
    for g in git_repos(f"{project}/git", quiet=True):
        copy = g.removesuffix("/.git")
        rel = copy[len(f"{project}/git"):].removeprefix("/")
        repo = f"{path}/{rel}" if rel else path
        unmerged += show_repo_status(repo, copy, rel)

    show_home_layer(cfg, f"{project}/home")

    # The private copies: at their path in the project, within shadow/.
    shadow = f"{project}/shadow"
    names = name_tests(cfg.PRIVATE)
    copies = names and find(shadow, "-mindepth", "1", "(", *names, ")",
                            "-type", "d", "-prune", "-print0", quiet=True)
    if copies:
        print("Private copies:")
    for p in sorted(copies, key=os.fsencode):
        rel = p[len(shadow) + 1:]
        size = du(p)
        # Unused: no such directory, nor will a tool create it (PRIVATE_IF).
        signal_file = cfg.PRIVATE_IF.get(rel)
        if not os.path.exists(f"{path}/{rel}") and not (
                signal_file and os.path.exists(f"{path}/{signal_file}")):
            size = f"{size}, unused: no {safe(rel)} in the project"
        print(f"  {safe(rel)}: {size}")
    return unmerged


def agent_file(path):
    """`path`, a file of the agent's home (~/.bashrc, .bashrc), relative
    to the home."""
    p, home = path, os.environ["HOME"]
    if p.startswith("~/"):
        p = p[2:]
    elif p.startswith(f"{home}/"):
        p = p[len(home) + 1:]
    elif p.startswith("/"):
        die(f"{p} is not in the agent's home.")
    p = p.removeprefix("./").removesuffix("/")
    if not p or p == "." or "/../" in f"/{p}/":
        die(f"Not a file of the agent's home: {path}")
    return p


def is_whiteout(path):
    """True if `path`, in a layer, records a deletion."""
    st = os.lstat(path)
    return stat.S_ISCHR(st.st_mode) and st.st_rdev == 0


def opaque_dirs(layer, rel):
    """The directories that `layer` marks opaque among those leading to
    `rel`, and in it: they replace the base's directory as a whole, since
    the agent deleted it, then created it again.  Promoting part of one
    would mix the two versions."""
    def opaque(d):
        try:
            return os.getxattr(d, "user.overlay.opaque", follow_symlinks=False) == b"y"
        except OSError:
            return False

    parts = rel.split("/")
    dirs = [os.path.join(layer, *parts[:i]) for i in range(1, len(parts))]
    target = os.path.join(layer, rel)
    if os.path.isdir(target) and not os.path.islink(target):
        dirs += [root for root, _, _ in os.walk(target)]
    return [d for d in dirs if opaque(d)]


def promote(cfg, paths):
    """Make the project's version of each path of the agent's home (a file,
    a symlink, a deletion, or a directory of them) the base version, for
    every project, after showing the changes and asking.  Each is then
    dropped from the project's layer, which sees the base version again.
    Nothing may run meanwhile: the base home must not change under a
    session, nor a project's layer."""
    lock_home(cfg, "exclusive")
    path = find_project(cfg)
    if path is None:
        die("No project here: run ai --promote in the project.")
    layer = f"{project_dir(cfg, path)}/home"
    if not os.path.exists(layer):
        die("The agent's home has no changes in this project.")
    layer = os.path.realpath(layer)
    base = os.path.realpath(cfg.AIHOME, strict=True)

    ops = []
    for p in paths:
        rel = agent_file(p)
        src = f"{layer}/{rel}"
        if not os.path.lexists(src):
            die(f"~/{rel} has no changes in this project (see ai --status).")
        if not inside(os.path.realpath(os.path.dirname(src)), layer):
            die(f"~/{rel}: its directory, in the project's layer, leads out of it.")
        if opaque_dirs(layer, rel):
            die(f"~/{rel}: the project replaced a directory there as a whole (deleted, "
                "then created again), which can't be merged into the base home: copy "
                "what you need by hand.")
        if os.path.isdir(src) and not os.path.islink(src):
            ops += sorted(find(src, "!", "-type", "d", "-print0"), key=os.fsencode)
        else:
            ops.append(src)
    for f in ops:
        rel = f[len(layer) + 1:]
        # A symlink planted in the base home must not lead the copy out.
        if not inside(os.path.realpath(os.path.dirname(f"{base}/{rel}")), base):
            die(f"~/AI/home/{rel}: its directory leads out of the base home.")
        if not (is_whiteout(f) or os.path.islink(f) or os.path.isfile(f)):
            die(f"~/{rel} is not a file, a symlink or a deletion.")
    if not ops:
        die("Nothing to promote.")

    for f in ops:
        rel = f[len(layer) + 1:]
        t = f"{base}/{rel}"
        if is_whiteout(f):
            print(f"Delete ~/{safe(rel)}")
        elif os.path.islink(f):
            print(f"Symlink ~/{safe(rel)} → {safe(os.readlink(f))}")
        else:
            old = t if os.path.isfile(t) and not os.path.islink(t) else "/dev/null"
            diff = subprocess.run(["diff", "-u", "--label", f"base ~/{safe(rel)}",
                                   "--label", f"project ~/{safe(rel)}", "--", old, f],
                                  stdout=subprocess.PIPE)
            sys.stdout.write(safe_text(os.fsdecode(diff.stdout)))
            sys.stdout.flush()
    if not confirm("Make this the base version, for every project?"):
        raise Exit(1)

    for f in ops:
        rel = f[len(layer) + 1:]
        t = f"{base}/{rel}"
        whiteout = is_whiteout(f)
        # rm first: cp would write through a symlink there.
        if subprocess.run(["rm", "-rf", "--", t]).returncode:
            raise Exit(1)
        if not whiteout:
            os.makedirs(os.path.dirname(t), exist_ok=True)
            if subprocess.run(["cp", "-P", "--preserve=mode,timestamps", "--", f, t]).returncode:
                raise Exit(1)
        os.unlink(f)
        print(f"Promoted ~/{safe(rel)}.")


def remove_tree(path):
    """Delete `path`, a directory of ai's.  Make it writable first: overlayfs
    leaves its work directory unreadable, and the agent can do the same in
    its private copies.  chmod -R doesn't follow the symlinks it meets, nor
    rm -r."""
    subprocess.run(["chmod", "-R", "u+rwx", "--", path], stderr=subprocess.DEVNULL)
    subprocess.run(["rm", "-rf", "--", path])


def reset_home(cfg):
    """Delete the project's layer of the agent's home, after showing it and
    asking: the project then sees the base home as it is."""
    path = find_project(cfg)
    if path is None:
        die("No project here: run ai --reset in the project.")
    project = project_dir(cfg, path)
    if not os.path.exists(f"{project}/home"):
        die("The agent's home has no changes in this project.")
    # No session in the project meanwhile, until the program exits.
    lock_work_path(cfg, path)
    show_home_layer(cfg, f"{project}/home")
    if not confirm("Delete the project's changes to the agent's home (its history, "
                   "memory, settings... there)?"):
        raise Exit(1)
    remove_tree(f"{project}/home.work")
    remove_tree(f"{project}/home")
    print(f"The agent's home in {rel_to_home(path)} is now the base home.")


def forget(cfg, given):
    """Delete what ai keeps for the project, after showing it and asking,
    and the "ai" remote of its repos."""
    if given is not None:
        # The directory may be gone.
        path = os.path.realpath(given)
        if not os.path.isfile(f"{project_dir(cfg, path)}/path"):
            die(f"{given} is not a project (see ai --list).")
    else:
        path = find_project(cfg)
        if path is None:
            die("No project here: run ai --forget in the project, or give its directory.")
    project = project_dir(cfg, path)
    unmerged = show_status(cfg, path)
    # No session in the project meanwhile, until the program exits.
    lock_work_path(cfg, path)
    if unmerged:
        warn("The agent's commits listed above are in no branch of yours, nor, for a repo")
        warn("that is gone, anywhere but in its clone: deleting the clones and the ai")
        warn("remote loses them.  Fetch and merge them first, or make branches of them")
        warn("(git branch NAME ai/BRANCH, after git fetch ai).")
    if not confirm(f"Delete {rel_to_home(project)}, and the ai remote of the project's repos?"):
        raise Exit(1)

    # Only the remotes leading to this project's clones.
    for g in git_repos(path, quiet=True):
        url = capture(git_config(f"{g}/config", "remote.ai.url")) or ""
        if url != f"{project}/git" and not url.startswith(f"{project}/git/"):
            continue
        check_plain_config(g)
        repo = g.removesuffix("/.git")
        # Not "git remote remove": it runs the repo's reference-transaction
        # hook, core.hooksPath or not (git 2.43).  The config written directly,
        # the refs deleted by update-ref, which honours core.hooksPath.
        if subprocess.run(git_config(f"{g}/config", "--remove-section", "remote.ai")).returncode:
            continue
        refs = capture(git("-C", repo, "for-each-ref", "--format=delete %(refname)",
                           "refs/remotes/ai/")) or ""
        # --no-deref: deleting ai/HEAD, which fetch can create, would otherwise
        # also delete the branch it points to, which fails the whole transaction.
        if not subprocess.run(git("-C", repo, "update-ref", "--no-deref", "--stdin"),
                              input=f"{refs}\n".encode(**ENCODING) if refs else b"").returncode:
            print(f"Repo {rel_to_pwd(repo)}: ai remote removed.")
    remove_tree(project)
    print(f"Forgot {rel_to_home(path)}.")


def list_projects(cfg):
    """Every project, with its size and the start of its latest session
    (when its path file was last touched), noting those with a session
    running and those whose directory is gone."""
    rows = []
    for f in project_path_files(cfg):
        path = read_path_file(f)
        lock = session_lock(cfg, path)
        if not os.path.isdir(path):
            state = f"gone: ai --forget {rel_to_home(path)}"
        elif os.path.exists(lock) and is_locked(lock):
            state = "session running"
        else:
            state = ""
        rows.append((rel_to_home(path), du(os.path.dirname(f)),
                     timestamp(os.path.getmtime(f), "%F %R"), state))
    if not rows:
        print("No projects yet: ai -w makes the current directory one.")
    width = max((len(row[0]) for row in rows), default=0)
    for name, size, when, state in rows:
        print(f"{name:<{width}}  {size:>5}  {when}{f'  {state}' if state else ''}")


# --- The command line ---------------------------------------------------


@dataclasses.dataclass
class Options:
    action: str = None                  # status, promote, reset, forget or list
    work_path: str = None
    ssh: bool = False
    read_only: list = dataclasses.field(default_factory=list)
    cmd: list = dataclasses.field(default_factory=list)
    promote_paths: list = dataclasses.field(default_factory=list)
    forget_dir: str = None


def parse_options(argv, action):
    opts = Options(action=action)
    i = 0
    while i < len(argv):
        arg = argv[i]
        i += 1
        if arg in ("-w", "--work"):
            try:
                opts.work_path = os.path.realpath(".", strict=True)
            except OSError:
                die("Cannot resolve the current directory.")
        elif arg == "--ssh":
            opts.ssh = True
        elif arg in ("--status", "--reset", "--list"):
            pass                        # the action is already set
        elif arg == "--forget":
            # An optional DIR, e.g. a project whose directory is gone.
            if i < len(argv) and not argv[i].startswith("-"):
                opts.forget_dir = argv[i]
                i += 1
        elif arg == "--promote":
            opts.promote_paths = argv[i:]
            if not opts.promote_paths:
                die("--promote needs the paths to promote.")
            break
        elif arg in ("--ro", "--read-only"):
            # All the patterns up to the next option or "--": an unquoted
            # glob, expanded by the shell, gives several.  A pattern
            # starting with "-" needs the --ro=PATTERN form or "./".
            if i == len(argv) or argv[i].startswith("-"):
                die(f"{arg} needs at least one pattern.")
            while i < len(argv) and not argv[i].startswith("-"):
                opts.read_only.append(argv[i])
                i += 1
        elif arg.startswith(("--ro=", "--read-only=")):
            opts.read_only.append(arg.partition("=")[2])
        elif arg == "--":
            opts.cmd = argv[i:]
            if not opts.cmd:
                die('Nothing after "--": give the command to run.')
            break
        elif arg.startswith("-"):
            die(f"Unknown option {arg} (see ai --help).")
        else:
            die(f'Unexpected "{arg}": put the command to run after "--" (see ai --help).')
    if action and (opts.work_path or opts.ssh or opts.read_only or opts.cmd):
        die(f"--{action} takes no other option.")
    return opts


def stop_on_signal(signum, _frame):
    """Leave through what ends the session, with the shell's usual status."""
    raise Exit(128 + signum)


def main(argv):
    if sys.version_info < (3, 12):
        die("Python 3.12 or later is needed (os.setns).")
    # --help and the commands on projects first: they need neither the
    # resource limits nor the checks.  Arguments after "--" belong to the
    # command, those after --promote are its paths.
    action = None
    for arg in argv:
        if arg == "--":
            break
        if arg in ("-h", "--help"):
            print(USAGE, end="")
            return 0
        if arg in ("--status", "--promote", "--reset", "--forget", "--list"):
            action = arg[2:]
            if action == "promote":
                break

    env = os.environ
    if "HOME" not in env:
        die("Cannot resolve $HOME.")
    cfg = load_config(env["HOME"])

    limits = resource_limits(cfg)
    if not env.get("AI_IN_SCOPE") and not action:
        enter_scope(limits, argv)

    opts = parse_options(argv, action)

    # On some distributions (such as Fedora), /home is a symlink.
    try:
        home = os.path.realpath(env["HOME"], strict=True)
    except OSError:
        die("Cannot resolve $HOME.")

    if action == "status":
        show_status(cfg)
        return 0
    if action == "promote":
        promote(cfg, opts.promote_paths)
        return 0
    if action == "reset":
        reset_home(cfg)
        return 0
    if action == "forget":
        forget(cfg, opts.forget_dir)
        return 0
    if action == "list":
        list_projects(cfg)
        return 0

    nft = check_session_tools(cfg)
    if opts.ssh and not os.access(cfg.AI_SSH_KEY, os.R_OK):
        die(f"--ssh: create the agent's key first: ssh-keygen -t ed25519 -f "
            f"'{cfg.AI_SSH_KEY}' -C ai-agent")

    work = None
    if opts.work_path:
        path = opts.work_path
        check_work_path(cfg, path, home)
        # The home lock first: a session refused for it changes nothing.
        lock_home(cfg, "shared")
        lock_work_path(cfg, path)
        # A distinct path per work dir, so that tools keeping per-directory
        # data (history, memory...) tell projects apart.  Mount outside
        # $HOME: / is a tmpfs, so no mount point is left behind in AIHOME.
        mount = (f"/work/{path[len(home) + 1:]}" if path.startswith(f"{home}/")
                 else f"/work-tmp{path}")
        work = WorkDir(path, mount, register_project(cfg, path))
    else:
        if opts.read_only:
            die("--ro needs -w: the patterns are in the work directory.")
        lock_home(cfg, "exclusive")

    session = Session(cfg, nft, opts.ssh, opts.read_only, opts.cmd, work=work)
    try:
        return run_session(session, env, opts.work_path)
    finally:
        session.cleanup()


def logical_cwd():
    """$PWD, as your shell keeps it, symlinks included, if it is the
    current directory; otherwise the real one."""
    try:
        cwd = os.getcwd()
        pwd = os.environ.get("PWD", "")
        if (pwd.startswith("/") and not {".", ".."} & set(pwd.split("/"))
                and os.path.samestat(os.stat(pwd), os.stat("."))):
            return pwd
        return cwd
    except OSError:
        return os.environ.get("PWD", "")


# Whatever the terminal or the file is, what is written goes out in order
# with what the commands write, the names as they are.
sys.stdout.reconfigure(line_buffering=True, **ENCODING)
sys.stderr.reconfigure(line_buffering=True, **ENCODING)



def show_thread_error(args):
    """Show an error in a thread as main shows its own: made safe, since
    what failed can be a name from the agent."""
    if issubclass(args.exc_type, SystemExit):
        return
    text = "".join(traceback.format_exception(args.exc_type, args.exc_value, args.exc_traceback))
    try:
        warn(f"ai: internal error in a thread:\n{safe_text(text)}")
    except OSError:
        pass                            # no terminal any more


threading.excepthook = show_thread_error

PWD = logical_cwd()
if sys.stdout.isatty():
    RED, NORMAL = "\033[31m", "\033[0m"
else:
    RED, NORMAL = "", ""


def entry_point():
    for sig in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
        signal.signal(sig, stop_on_signal)
    status = 1
    try:
        status = main(sys.argv[1:])
    except BrokenPipeError:
        status = 128 + signal.SIGPIPE
    except OSError as e:
        warn(f"ai: {safe(str(e))}")
    except SystemExit as e:
        status = e.code
    except Exception:
        warn(f"ai: internal error:\n{safe_text(traceback.format_exc())}")
    try:
        sys.stdout.flush()
    except OSError:
        # Nothing more to write there, at Python's exit either.
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
    sys.exit(status)


if __name__ == "__main__":
    entry_point()
